<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VizbeeSampleXbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="#0b0d10">
    <!--
      Chromium-based WebView2 from WinUI 2.x (Microsoft.UI.Xaml.Controls).
      The Source URL is the same CloudFront-hosted web build that tizen/webos
      load — single web app, three native shells. Loaded() in code-behind
      ensures the CoreWebView2 environment is ready before any host-object
      bridge is attached.
    -->
    <Grid>
        <muxc:WebView2
            x:Name="WebView"
            Source="https://d1a16fhfuhnwgt.cloudfront.net/xbox/index.html"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />
        <!-- Build-marker overlay. Visible in the top-right corner of the TV
             at all times. Populated from Package.Current.Id.Version in
             MainPage_Loaded so the version number on screen is generated by
             whichever build is actually running, not by anything cached. If
             this badge isn't visible, the new code isn't on the device. -->
        <Border Background="#A0000000"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Padding="10,4,10,5"
                CornerRadius="0,0,0,6"
                IsHitTestVisible="False">
            <TextBlock x:Name="VersionLabel"
                       Foreground="#1ed679"
                       FontFamily="Consolas"
                       FontSize="14"
                       Text="build ?" />
        </Border>
    </Grid>
</Page>
